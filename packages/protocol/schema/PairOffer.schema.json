{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hubURL": {
      "type": "string",
      "format": "uri"
    },
    "deviceId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "pubKeys": {
      "type": "object",
      "properties": {
        "kem": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        },
        "sigAlg": {
          "type": "string",
          "enum": [
            "ES256",
            "Ed25519"
          ]
        }
      },
      "required": [
        "kem",
        "sig",
        "sigAlg"
      ],
      "additionalProperties": false
    },
    "secret": {
      "type": "string"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "hubURL",
    "deviceId",
    "name",
    "pubKeys",
    "secret",
    "expiresAt"
  ],
  "additionalProperties": false
}
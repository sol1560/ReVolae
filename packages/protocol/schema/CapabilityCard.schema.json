{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "appBundleId": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "control": {
      "type": "string",
      "enum": [
        "button",
        "input_button",
        "list",
        "toggle",
        "picker",
        "form"
      ]
    },
    "fields": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "bool",
              "choice",
              "date"
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "label",
          "kind",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "applescript",
            "jxa",
            "shortcut",
            "gui",
            "shell"
          ]
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "template"
      ],
      "additionalProperties": false
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "applescript",
            "jxa",
            "shortcut",
            "gui",
            "shell"
          ]
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "template"
      ],
      "additionalProperties": false
    },
    "staticLevel": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "sdef",
        "menu",
        "window",
        "shortcuts",
        "explored",
        "adapter"
      ]
    },
    "hidden": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "appBundleId",
    "appName",
    "name",
    "description",
    "control",
    "fields",
    "action",
    "staticLevel",
    "source",
    "hidden"
  ],
  "additionalProperties": false
}